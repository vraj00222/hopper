{
  "id": "pipe_chokepoint_priority",
  "name": "chokepoint-priority",
  "version": "1.0.0",
  "description": "Reachability then ownership first, so the on-call is paged before the analysis finishes. Obligation, agents and the remaining executors follow. Deliberately skips deployment and precedent traversal: on a chokepoint package the cost of a late page beats the cost of an incomplete report.",
  "entry": "reachability",
  "nodes": [
    {
      "id": "reachability",
      "kind": "cypher",
      "op": "traverse.reachability",
      "params": {
        "query": "Q1",
        "max_depth": 5,
        "collect_chain": true,
        "stop_at_first_customer": true,
        "budget_ms": 400
      },
      "next": ["ownership"]
    },
    {
      "id": "ownership",
      "kind": "cypher",
      "op": "traverse.ownership",
      "params": {
        "query": "Q5",
        "require_oncall": true,
        "budget_ms": 250
      },
      "next": ["page-oncall"]
    },
    {
      "id": "page-oncall",
      "kind": "tool",
      "op": "tool.page_oncall",
      "params": {
        "auto": true,
        "urgency": "high",
        "pre_analysis": true,
        "note": "paged before the panel runs - chokepoint blast radius"
      },
      "next": ["obligation"]
    },
    {
      "id": "obligation",
      "kind": "cypher",
      "op": "traverse.obligation",
      "params": {
        "clause_type": "breach_notification",
        "order_by": "hours ASC",
        "start_clock": true,
        "budget_ms": 600
      },
      "next": ["agents"]
    },
    {
      "id": "agents",
      "kind": "agent",
      "op": "agent.dispatch",
      "params": {
        "agents": ["reachability", "patch-engineer", "obligation-officer", "arbiter"],
        "mode": "fast-panel",
        "allow_conflict": true,
        "timeout_ms": 5000
      },
      "next": ["open-pr"]
    },
    {
      "id": "open-pr",
      "kind": "tool",
      "op": "tool.open_pr",
      "params": { "gate": "arbiter.actions contains open_pr", "auto": true },
      "next": ["notify-customer"]
    },
    {
      "id": "notify-customer",
      "kind": "tool",
      "op": "tool.notify_customer",
      "params": {
        "gate": "arbiter.actions contains notify_customer",
        "auto": false,
        "requires_approval": true
      },
      "next": ["open-ticket"]
    },
    {
      "id": "open-ticket",
      "kind": "tool",
      "op": "tool.open_ticket",
      "params": { "gate": "arbiter.actions contains open_ticket", "auto": true },
      "next": ["writeback"]
    },
    {
      "id": "writeback",
      "kind": "writeback",
      "op": "writeback.graph",
      "params": {
        "write": ["AgentVerdict", "Decision", "Incident"],
        "record_run": true
      }
    }
  ],
  "handles": [
    { "ecosystem": "npm", "severity_band": "critical", "depth_band": "deep" },
    { "ecosystem": "npm", "severity_band": "critical", "depth_band": "shallow" },
    { "ecosystem": "npm", "severity_band": "critical", "depth_band": "direct" },
    { "ecosystem": "npm", "severity_band": "high", "depth_band": "deep" },
    { "ecosystem": "npm", "severity_band": "high", "depth_band": "direct" },
    { "ecosystem": "npm", "severity_band": "moderate", "depth_band": "direct" }
  ]
}
