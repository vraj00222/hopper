# HOPPER — every module runs with MOCK=true and zero network.
# Set MOCK=false only when you want live sponsor SDKs and real side effects.
MOCK=true

# FalkorDB (memory). Docker: npm run falkor:up
FALKOR_URL=redis://localhost:6379
FALKOR_GRAPH=hopper

# LaserData (motion in). Cloud free tier connection string.
# Unset -> the local in-process bus, which the whole demo runs on.
# LASER_URL=

# RocketRide (motion out). Unset -> the local portable-JSON pipeline runtime.
# ROCKETRIDE_URL=

# Guild (governance). Unset -> the local control plane: sessions, credentials,
# HITL approvals, session traces.
# GUILD_API_URL=
# GUILD_WORKSPACE=hopper

# Action-layer credentials. These belong in Guild's credential store, not here.
# They are resolved at execution time and never enter an agent context window.
# GITHUB_TOKEN=
# GITHUB_REPO=vraj00222/hopper-sandbox
# SLACK_WEBHOOK=

# Optional: real LLM reasoning for the four agents. Without it they are
# deterministic and offline, which is what the demo runs on.
# ANTHROPIC_API_KEY=
